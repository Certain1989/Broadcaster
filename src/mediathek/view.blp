using Gtk 4.0;
using Adw 1;

template $TvMediathekView: Adw.Bin {
  [child]
  Adw.ToolbarView {
    [top]
    Gtk.Box search_toolbar {
      orientation: vertical;
      spacing: 6;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      styles [
        "tv-controls"
      ]

      // Inset controls from the rounded panel instead of restyling them.
      Gtk.Box {
        orientation: horizontal;
        spacing: 8;
        margin-top: 3;
        margin-start: 4;
        margin-end: 4;

        Gtk.SearchEntry search_entry {
          placeholder-text: _("Search the Mediathek");
          hexpand: true;
          valign: center;
          search-delay: 250;
          text: bind template.query_string bidirectional;
        }

        Gtk.Button keyboard_button {
          icon-name: "input-keyboard-symbolic";
          tooltip-text: _("Open on-screen keyboard");
          // At 600px, GTK allocates 48x42 from a 60x52 request.
          // Request 56px high; the actual >=48x44 target is checked by GTK.
          width-request: 60;
          height-request: 56;
          valign: center;
        }

        Gtk.ToggleButton {
          icon-name: "search-global-symbolic";
          tooltip-text: _("Search Everywhere");
          valign: center;
          active: bind template.search_everywhere bidirectional;
        }

        Gtk.ToggleButton {
          icon-name: "month-symbolic";
          tooltip-text: _("Include Future Shows");
          valign: center;
          active: bind template.include-future bidirectional;
        }
      }

      Gtk.Box filters_toolbar {
        orientation: horizontal;
        spacing: 8;
        margin-bottom: 3;
        margin-start: 4;
        margin-end: 4;

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;

          Gtk.Label {
            label: _("Channel");
            valign: center;
          }

          Gtk.DropDown broadcaster_filter {
            tooltip-text: _("Filter by broadcaster");
            // Compact minimum; use surplus space at ordinary TV widths.
            hexpand: true;
            width-request: 120;
          }
        }

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;

          Gtk.Label {
            label: _("Duration");
            valign: center;
          }

          Gtk.DropDown duration_filter {
            tooltip-text: _("Filter by duration");
            hexpand: true;
            width-request: 128;
          }
        }

        Gtk.MenuButton sort_button {
          label: _("Sort");
          tooltip-text: _("Sort results");
          menu-model: sort_menu;
        }
      }
    }

    Gtk.Stack stack {
      visible-child: status_page;

      Adw.StatusPage status_page {
        icon-name: "loupe-symbolic";
        title: _("Search for Content");
        description: _("Start typing in the search bar to see a list of matching shows.\n\nThe search field supports <a href=\"https://github.com/mediathekview/mediathekviewweb/blob/master/README.md#erweiterte-suche\">MediathekViewWeb's advanced search syntax</a> (German).");
      }

      Adw.StatusPage nothing_found_view {
        icon-name: "item-missing-symbolic";
        title: _("No Results");
        description: _("Try different search terms or adjust the search filters");
      }

      Adw.Spinner loading_view {
        halign: center;
        valign: center;
        width-request: 32;
        height-request: 32;
      }

      Adw.StatusPage error_view {
        icon-name: "error-symbolic";
        title: _("Could Not Load Results");

        child: Gtk.Button {
          label: _("Retry");
          halign: center;
          action-name: "window.reload";

          styles [
            "pill",
            "suggested-action"
          ]
        };
      }

      Gtk.ScrolledWindow results_view {
        Adw.Clamp {
          maximum-size: 1240;
          tightening-threshold: 1000;
          Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Gtk.ListBox results_list {
              styles [
                "boxed-list",
                "tv-results"
              ]
            }

            Gtk.Button load_more_button {
              visible: bind template.more-available;
              halign: center;
              label: _("Load More");
              action-name: "mediathek.load-more";
            }
          }
        }
      }
    }
  }
}

menu sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("Channel");
      action: "mediathek.sort-by";
      target: "channel";
    }

    item {
      label: _("Date");
      action: "mediathek.sort-by";
      target: "date";
    }

    item {
      label: _("Duration");
      action: "mediathek.sort-by";
      target: "duration";
    }
  }

  section {
    label: _("Sort Order");

    item {
      label: _("Ascending");
      action: "mediathek.sort-order";
      target: "ascending";
    }

    item {
      label: _("Descending");
      action: "mediathek.sort-order";
      target: "descending";
    }
  }
}
