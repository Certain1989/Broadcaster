using Gtk 4.0;

template $TvLiveCard: Gtk.ListBoxRow {
  activatable: true;
  selectable: false;

  styles [
    "tv-result-row"
  ]

  Gtk.Box {
    orientation: vertical;
    hexpand: true;
    vexpand: true;
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Gtk.Box {
      orientation: horizontal;
      spacing: 12;

      styles [
        "item-card"
      ]

      Gtk.Box {
        orientation: vertical;
        vexpand: true;
        valign: center;
        spacing: 8;

        Gtk.Image icon {
          width-request: 64;
          height-request: 64;
          pixel-size: 64;
          tooltip-text: bind template.channel as <$ChannelObject>.name;
        }

        Gtk.Label fallback_icon {
          visible: false;
          width-request: 64;
          height-request: 64;
          tooltip-text: bind template.channel as <$ChannelObject>.name;
          styles [
            "channel-fallback"
          ]
        }

        Gtk.Box {
          orientation: horizontal;
          halign: center;
          spacing: 4;

          Gtk.Button play_button {
            icon-name: "play-symbolic";
            tooltip-text: _("Play");
            action-name: "card.play";

            styles [
              "circular"
            ]
          }
        }
      }

      Gtk.Box {
        orientation: vertical;
        spacing: 8;
        hexpand: true;
        vexpand: true;
        valign: center;

        Gtk.Label title {
          label: bind template.channel as <$ChannelObject>.title;
          tooltip-text: bind template.channel as <$ChannelObject>.title;
          ellipsize: end;

          styles [
            "heading"
          ]

          halign: start;
        }

        Gtk.Label subtitle {
          label: bind template.channel as <$ChannelObject>.subtitle;
          tooltip-text: bind template.channel as <$ChannelObject>.subtitle;
          ellipsize: end;

          styles [
            "dimmed"
          ]

          halign: start;
        }

        Gtk.Box {
          valign: center;
          spacing: 6;

          Gtk.Label channel {
            label: bind template.channel as <$ChannelObject>.name;
            tooltip-text: bind template.channel as <$ChannelObject>.name;
            ellipsize: end;
          }

          Gtk.Label timespan {
            halign: end;
            hexpand: true;
            label: bind template.channel as <$ChannelObject>.timespan;

            styles [
              "numeric"
            ]
          }
        }

        Gtk.ProgressBar progress {}
      }
    }

    Gtk.Revealer revealer {
      visible: false;
      reveal-child: bind template.expanded;
      transition-type: none;

      Gtk.Box {
        orientation: vertical;
        spacing: 6;

        Gtk.Label description {
          label: bind template.channel as <$ChannelObject>.description;
          halign: start;
          use-markup: true;
          wrap: true;

          styles [
            "body"
          ]
        }

      }
    }
  }
}
