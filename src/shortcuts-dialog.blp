using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Show livestreams");
      action-name: "window.show-live";
    }

    Adw.ShortcutsItem {
      title: _("Show Mediathek");
      action-name: "window.show-mediathek";
    }

    Adw.ShortcutsItem {
      title: _("Reload");
      action-name: "window.reload";
    }

    Adw.ShortcutsItem {
      title: _("Search");
      action-name: "window.search";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit application");
      action-name: "app.quit";
    }
  }
}
