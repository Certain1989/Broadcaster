msgstr "Televido"

#: data/io.github._45054.TelevidoFritz.desktop.in:6
msgid "Access German-language public broadcasting live streams and archives"
msgstr ""
"Verken/Bekijk livestreams en archieven van de Duitstalige publieke omroepen"

